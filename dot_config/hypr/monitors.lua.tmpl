-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
--
-- Ported from the pre-Omarchy-4 monitors.conf.tmpl. Machine is selected by
-- hostname; on the laptop the layout is chosen by how many displays are
-- currently attached, via the chezmoi-detect-monitors helper.
{{ if eq .chezmoi.hostname "omarchy" -}}
-- Home desktop Omarchy PC

hl.env("GDK_SCALE", "1")

-- Left - Dell 24"
hl.monitor({ output = "desc:Dell Inc. DELL P2419HC", mode = "1920x1080@60", position = "-1920x0", scale = 1 })

-- Center - Philips 32"
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 325E1", mode = "2560x1440@59.95", position = "0x0", scale = 1 })

-- Right - Philips 27" (landscape)
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 275E1", mode = "2560x1440@59.95", position = "2560x0", scale = 1 })

{{- else if eq .chezmoi.hostname "telchar" -}}
-- Omarchy Framework 13" laptop
{{ $monitors := (output "chezmoi-detect-monitors" | fromJson) -}}

{{- if eq (len $monitors) 100 }}
-- Custom config for 3 external displays + internal (DISABLED: the 100 is a
-- sentinel that never matches; change it to 4 to re-enable this layout.)

hl.env("GDK_SCALE", "2")

-- Internal display
hl.monitor({ output = "desc:BOE NE135A1M-NY1", mode = "preferred", position = "-1440x1080", scale = 2 })

-- Left - Dell 24"
hl.monitor({ output = "desc:Dell Inc. DELL P2419HC", mode = "1920x1080@60", position = "-1920x0", scale = 1 })

-- Center - Philips 32"
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 325E1", mode = "2560x1440@59.95", position = "0x0", scale = 1 })

-- Right - Philips 27" rotated (portrait)
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 275E1", mode = "2560x1440@59.95", position = "2560x-580", scale = 1, transform = 1 })
{{- end }}

{{- if eq (len $monitors) 3 }}
-- Custom config for 2 external displays + internal (not connecting left Dell)
--
-- Positions are explicit rather than "auto" so the three displays line up by
-- their vertical centres. Both externals are now landscape 2560x1440, so only
-- the shorter internal panel needs an offset.
--
-- Logical sizes: internal 1440x960 (scale 2), centre 2560x1440, right
-- 2560x1440. Offset = (1440 - own_height) / 2, so internal sits at y=240.

hl.env("GDK_SCALE", "2")

-- Internal display
hl.monitor({ output = "desc:BOE NE135A1M-NY1", mode = "preferred", position = "0x240", scale = 2 })

-- Center - Philips 32"
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 325E1", mode = "2560x1440@59.95", position = "1440x0", scale = 1 })

-- Right - Philips 27" (landscape)
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 275E1", mode = "2560x1440@59.95", position = "4000x0", scale = 1 })
{{- end }}

{{- if le (len $monitors) 2 }}
-- Default config: internal + at most one external (Hyprland auto placement)

hl.env("GDK_SCALE", "2")
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- LG TV at office
hl.monitor({ output = "desc:LG Electronics LG TV SSCR2", mode = "3840x2160@30", position = "auto", scale = 2 })
{{- end }}

{{- else }}
-- Generic fallback for non-configured machines

hl.env("GDK_SCALE", "2")
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
{{- end }}
