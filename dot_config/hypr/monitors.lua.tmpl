-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
{{ if eq .chezmoi.hostname "telchar" -}}
-- Omarchy Framework 13" laptop
--
-- Displays place and scale themselves; only the ones that get it wrong are
-- named below.
--
-- Rule order matters: Hyprland applies the last matching rule, so the
-- catch-all has to come first or it would override the specific rules.
--
-- The internal panel is matched by connector name: its `desc:` rule silently
-- stopped matching on 2026-09-27 and the catch-all won.
--
-- Do not use `omarchy-hyprland-monitor-scaling` to change a scale: it writes
-- the value into the catch-all rule, which then applies to every display.

hl.env("GDK_SCALE", "1")

-- Anything not named below (LG 40WT95UF at 5120x2160 at home lands here)
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.25 })

-- Internal display, pinned left so externals land to its right
hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x0", scale = 2 })

-- LG TV at office
hl.monitor({ output = "desc:LG Electronics LG TV SSCR2", mode = "3840x2160@30", position = "auto", scale = 2 })

-- Philips 32" at work (2560x1440); the catch-all's 1.25 makes it too large.
-- Explicit position: "auto" put it left of the laptop.
hl.monitor({ output = "desc:Philips Consumer Electronics Company PHL 325E1", mode = "preferred", position = "1440x0", scale = 1 })

{{- else }}
-- Generic fallback for non-configured machines

hl.env("GDK_SCALE", "2")
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
{{- end }}
