# Repo tooling, not a dotfile.
test-bash-chain.sh

private_dot_ssh/*
private_dot_gnupg/*
.secrets
.secretgitconfig
.cache/
# ~/.local is state and caches, except the helper scripts tmux key bindings
# call: those have to travel with the bindings that reference them, or a
# machine without them gets a binding that silently does nothing (which is how
# Prefix+C-j broke on anduril). A directory cannot be un-ignored once ignored,
# hence the step-by-step pattern.
.local/*
!.local/bin
.local/bin/*
!.local/bin/tmux-describe
!.local/bin/tmux-status
!.local/bin/tmux-zoxide-cd.sh
Library/
.config/1Password/
.config/github-copilot/
.config/BraveSoftware/
.config/chromium*/
.config/google-chrome*/
.config/microsoft-edge-dev/
.config/vivaldi*/
.config/Signal/
.config/spotify/
.config/JetBrains/
.config/nvim/lazy-lock.json

# Holds ntfy credentials for omarchy-phone-notify. This repo is public.
.config/omarchy/phone-notify.env

# Backups left by the Omarchy 4 upgrade and by hand-porting its configs.
.config/hypr/*.bak
.config/hypr/*.stock.bak
**/*.omarchy-upgrade-to-quattro.*.bak

# GUI configs belong only on the desktop machines. A headless Ubuntu box would
# otherwise get Hyprland, terminal-emulator and Omarchy files it cannot use —
# and bindings.lua.tmpl needs data vars (basecamp_account, discord_channel)
# that such a host has no chezmoi.toml to supply, which fails the whole apply.
{{ if not (has .chezmoi.hostname (list "omarchy" "telchar")) }}
.config/hypr/
.config/alacritty/
.config/ghostty/
.config/omarchy/
.config/systemd/user/omarchy-phone-notify.service
{{ end }}
